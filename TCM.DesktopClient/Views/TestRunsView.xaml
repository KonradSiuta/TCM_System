<UserControl x:Class="TCM.DesktopClient.Views.TestRunsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Margin="0,0,15,0" Padding="0,0,15,0">
            <StackPanel>
                <Button Content="+ Create New Run" Command="{Binding OpenCreatorCommand}" Background="#FF007ACC" Foreground="White" BorderThickness="0" Padding="10" Margin="0,0,0,15" FontWeight="Bold"/>

                <TextBlock Text="History" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                <ListBox ItemsSource="{Binding TestRuns}" SelectedItem="{Binding SelectedRun}" DisplayMemberPath="Name" BorderThickness="0" MinHeight="300" Background="Transparent"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">

            <StackPanel Visibility="{Binding IsCreatingNew, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Create New Test Run" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <WrapPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Name:" Width="50" VerticalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NewRunName}" Width="150" Margin="0,0,15,5" Padding="5"/>

                    <TextBlock Text="Environment:" Width="80" VerticalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NewRunEnvironment}" Width="150" Margin="0,0,15,5" Padding="5"/>

                    <TextBlock Text="Planned End Date:" Width="100" VerticalAlignment="Center" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding NewRunPlannedEndDate}" Width="120" Margin="0,0,0,5"/>
                </WrapPanel>

                <Border Background="#FFEAEAEA" Padding="10" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Quick Select by Priority:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriorityFilter}" Width="120" Margin="0,0,10,0"/>
                        <Button Content="Select Matching" Command="{Binding SelectByPriorityCommand}" Background="#FF17A2B8" Foreground="White" BorderThickness="0" Padding="5,2"/>
                    </StackPanel>
                </Border>

                <DataGrid ItemsSource="{Binding AvailableTestCases}" AutoGenerateColumns="False" CanUserAddRows="False" Height="300" Margin="0,0,0,15">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                        <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Ext. ID" Binding="{Binding ExternalId}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save &amp; Create Run" Command="{Binding CreateRunCommand}" Background="#FF28A745" Foreground="White" BorderThickness="0" Padding="10" Width="150" Margin="0,0,10,0"/>
                    <Button Content="Cancel" Command="{Binding CancelCreatorCommand}" Background="#FF6C757D" Foreground="White" BorderThickness="0" Padding="10" Width="100"/>
                </StackPanel>
            </StackPanel>


            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCreatingNew}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedRun}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <StackPanel Margin="0,0,0,15">

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding SelectedRun.Name}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedRun.Environment, StringFormat='Environment: {0}'}" Foreground="Gray" TextWrapping="Wrap"/>

                            <TextBlock Text="{Binding SelectedRun.PlannedEndDate, StringFormat='Deadline: {0:yyyy-MM-dd}'}" Foreground="#FF17A2B8" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRun.PlannedEndDate}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="Import Automated Results (XML)" Command="{Binding ImportResultsCommand}" Background="#FF6F42C1" Foreground="White" BorderThickness="0" Padding="10,5" Margin="0,0,5,5"/>
                            <Button Content="Export PDF Report" Command="{Binding ExportPdfCommand}" Background="#FFDC3545" Foreground="White" BorderThickness="0" Padding="10,5" Margin="0,0,0,5" FontWeight="SemiBold"/>
                        </WrapPanel>
                    </Grid>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsAdmin}" Value="True"/>
                                                <Condition Binding="{Binding IsEditingRun}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Content="Edit Details" Command="{Binding StartEditCommand}" Background="#FF17A2B8" Foreground="White" BorderThickness="0" Padding="10,4" Margin="0,0,10,0"/>
                            <Button Content="Delete Run" Command="{Binding DeleteRunCommand}" Background="#FFDC3545" Foreground="White" BorderThickness="0" Padding="10,4"/>
                        </StackPanel>

                        <Border Background="#FFFFE8A1" Padding="10" CornerRadius="5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingRun}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="Name:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                <TextBox Text="{Binding EditRunName}" Width="150" Padding="3" Margin="0,0,15,5"/>

                                <TextBlock Text="Environment:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                <TextBox Text="{Binding EditRunEnvironment}" Width="150" Padding="3" Margin="0,0,15,5"/>

                                <TextBlock Text="New End Date:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                <DatePicker SelectedDate="{Binding EditRunPlannedEndDate}" Width="120" Padding="3" Margin="0,0,15,5"/>

                                <Button Content="Save" Command="{Binding SaveEditCommand}" Background="#FF28A745" Foreground="White" BorderThickness="0" Padding="10,2" Margin="0,0,5,5"/>
                                <Button Content="Cancel" Command="{Binding CancelEditCommand}" Background="#FF6C757D" Foreground="White" BorderThickness="0" Padding="10,2" Margin="0,0,0,5"/>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <DataGrid ItemsSource="{Binding SelectedRun.Executions}" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#FFF0F0F0" Height="400">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Test ID" Binding="{Binding TestCase.ExternalId}" Width="100"/>
                        <DataGridTextColumn Header="Title" Binding="{Binding TestCase.Title}" Width="200"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>

                        <DataGridTextColumn Header="Automated Logs / Notes" Binding="{Binding Notes}" Width="250">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Manual Override" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Pass" Command="{Binding DataContext.SetPassedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#FF28A745" Foreground="White" BorderThickness="0" Padding="5,2" Margin="0,0,5,0" Width="60"/>
                                        <Button Content="Fail" Command="{Binding DataContext.SetFailedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#FFDC3545" Foreground="White" BorderThickness="0" Padding="5,2" Width="60"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

        </Grid>
    </Grid>
</UserControl>