<UserControl x:Class="TCM.DesktopClient.Views.TestRunsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0" Margin="0,0,15,0" Padding="0,0,15,0">
            <StackPanel>
                <Button Content="+ Create new run" Command="{Binding OpenCreatorCommand}" IsEnabled="{Binding IsAdmin}" Background="#FF007ACC" Foreground="White" BorderThickness="0" Padding="10" Margin="0,0,0,15" FontWeight="Bold"/>

                <TextBlock Text="History" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                <ListBox ItemsSource="{Binding TestRuns}" SelectedItem="{Binding SelectedRun}" DisplayMemberPath="Name" BorderThickness="0" MinHeight="300" Background="Transparent"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">

            <StackPanel Visibility="{Binding IsCreatingNew, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Create new test run" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                <WrapPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Name:" Width="50" VerticalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NewRunName}" Width="150" Margin="0,0,15,5" Padding="5"/>

                    <TextBlock Text="Environment:" Width="80" VerticalAlignment="Center" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding NewRunEnvironment}" Width="150" Margin="0,0,15,5" Padding="5"/>

                    <TextBlock Text="Planned end date:" Width="100" VerticalAlignment="Center" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding NewRunPlannedEndDate}" Width="120" Margin="0,0,0,5"/>
                </WrapPanel>

                <Border Background="#FFEAEAEA" Padding="10" Margin="0,0,0,10" CornerRadius="5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Quick select by priority:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding SelectedPriorityFilter}" Width="120" Margin="0,0,10,0"/>
                        <Button Content="Select matching" Command="{Binding SelectByPriorityCommand}" Background="#FF17A2B8" Foreground="White" BorderThickness="0" Padding="5,2"/>
                    </StackPanel>
                </Border>

                <DataGrid ItemsSource="{Binding AvailableTestCases}" AutoGenerateColumns="False" CanUserAddRows="False" Height="300" Margin="0,0,0,15">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                        <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Testcase ID" Binding="{Binding ExternalId}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save &amp; create run" Command="{Binding CreateRunCommand}" Background="#FF28A745" Foreground="White" BorderThickness="0" Padding="10" Width="150" Margin="0,0,10,0"/>
                    <Button Content="Cancel" Command="{Binding CancelCreatorCommand}" Background="#FF6C757D" Foreground="White" BorderThickness="0" Padding="10" Width="100"/>
                </StackPanel>
            </StackPanel>


            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCreatingNew}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedRun}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <StackPanel Margin="0,0,0,15">

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding SelectedRun.Name}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedRun.Environment, StringFormat='Environment: {0}'}" Foreground="Gray" TextWrapping="Wrap"/>

                            <TextBlock Text="{Binding SelectedRun.PlannedEndDate, StringFormat='Deadline: {0:yyyy-MM-dd}'}" Foreground="#FF17A2B8" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedRun.PlannedEndDate}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="Import automated results (XML)" Command="{Binding ImportResultsCommand}" IsEnabled="{Binding CanExecute}" Background="#FF6F42C1" Foreground="White" BorderThickness="0" Padding="10,5" Margin="0,0,5,5"/>
                            <Button Content="Export PDF report" Command="{Binding ExportPdfCommand}" Background="#FFDC3545" Foreground="White" BorderThickness="0" Padding="10,5" Margin="0,0,0,5" FontWeight="SemiBold"/>
                        </WrapPanel>
                    </Grid>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsAdmin}" Value="True"/>
                                                <Condition Binding="{Binding IsEditingRun}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Content="Edit details" Command="{Binding StartEditCommand}" IsEnabled="{Binding IsAdmin}" Background="#FF17A2B8" Foreground="White" BorderThickness="0" Padding="10,4" Margin="0,0,10,0"/>
                            <Button Content="Delete run" Command="{Binding DeleteRunCommand}" IsEnabled="{Binding IsAdmin}" Background="#FFDC3545" Foreground="White" BorderThickness="0" Padding="10,4"/>
                        </StackPanel>

                        <Border Background="#FFFFE8A1" Padding="10" CornerRadius="5" Margin="0,5,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingRun}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="Name:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                <TextBox Text="{Binding EditRunName}" Width="150" Padding="3" Margin="0,0,15,5"/>

                                <TextBlock Text="Environment:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                <TextBox Text="{Binding EditRunEnvironment}" Width="150" Padding="3" Margin="0,0,15,5"/>

                                <TextBlock Text="New end date:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                <DatePicker SelectedDate="{Binding EditRunPlannedEndDate}" Width="120" Padding="3" Margin="0,0,15,5"/>

                                <Button Content="Save" Command="{Binding SaveEditCommand}" Background="#FF28A745" Foreground="White" BorderThickness="0" Padding="10,2" Margin="0,0,5,5"/>
                                <Button Content="Cancel" Command="{Binding CancelEditCommand}" Background="#FF6C757D" Foreground="White" BorderThickness="0" Padding="10,2" Margin="0,0,0,5"/>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="{Binding ViewToggleText}" Command="{Binding ToggleViewCommand}" Background="#FF007ACC" Foreground="White" BorderThickness="0" Padding="15,6" FontWeight="SemiBold"/>
                </StackPanel>

                <Grid>

                    <UniformGrid Columns="2" Height="400">
                        <UniformGrid.Style>
                            <Style TargetType="UniformGrid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowStatistics}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </UniformGrid.Style>

                        <Border Background="White" CornerRadius="8" Margin="10" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#DDDDDD" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Execution progress" FontSize="16" Foreground="#555" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,20"/>
                                <Grid Width="150" Height="150" HorizontalAlignment="Center">
                                    <Ellipse Stroke="#E0E0E0" StrokeThickness="20"/>
                                    <Ellipse Stroke="#007ACC" StrokeThickness="20" StrokeDashArray="{Binding ExecutionDashArray}" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock Text="{Binding ExecutionText}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                </Grid>
                                <TextBlock Text="Shows how many tests have been executed" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" Margin="0,20,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="8" Margin="10" Padding="15" BorderBrush="#E0E0E0" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#DDDDDD" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                            </Border.Effect>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Pass rate" FontSize="16" Foreground="#555" HorizontalAlignment="Center" FontWeight="Bold" Margin="0,0,0,20"/>
                                <Grid Width="150" Height="150" HorizontalAlignment="Center">
                                    <Ellipse Stroke="#DC3545" StrokeThickness="20"/>
                                    <Ellipse Stroke="#28A745" StrokeThickness="20" StrokeDashArray="{Binding ResultDashArray}" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90"/>
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <TextBlock Text="{Binding ResultText}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                                </Grid>
                                <TextBlock Text="Calculated only for executed tests" FontSize="12" Foreground="Gray" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>


                    <DataGrid ItemsSource="{Binding SelectedRun.Executions}" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#FFF0F0F0" Height="400">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowStatistics}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Testcase ID" Binding="{Binding TestCase.ExternalId}" Width="90"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding TestCase.Title}" Width="150"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>

                            <DataGridTemplateColumn Header="Logs / Notes" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                                                 IsEnabled="{Binding DataContext.CanExecute, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                 TextWrapping="Wrap" AcceptsReturn="True" Padding="2" Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Defect URL" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding DefectUrl, UpdateSourceTrigger=PropertyChanged}" 
                                                 IsEnabled="{Binding DataContext.CanExecute, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                 Padding="2" Margin="2" ToolTip="e.g. https://jira.com/browse/BUG-123"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Actions" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Pass" Command="{Binding DataContext.SetPassedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" IsEnabled="{Binding DataContext.CanExecute, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#FF28A745" Foreground="White" BorderThickness="0" Padding="5,2" Margin="0,0,5,5" Width="45"/>
                                            <Button Content="Fail" Command="{Binding DataContext.SetFailedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" IsEnabled="{Binding DataContext.CanExecute, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#FFDC3545" Foreground="White" BorderThickness="0" Padding="5,2" Margin="0,0,5,5" Width="45"/>
                                            <Button Content="Save" Command="{Binding DataContext.SaveExecutionDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" IsEnabled="{Binding DataContext.CanExecute, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#FF007ACC" Foreground="White" BorderThickness="0" Padding="5,2" Margin="0,0,0,5" Width="45" ToolTip="Save Notes and URL manually"/>
                                        </WrapPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>