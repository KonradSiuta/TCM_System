<UserControl x:Class="TCM.DesktopClient.Views.TestCasesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Import from source code" Command="{Binding ImportSourceCommand}" IsEnabled="{Binding CanEdit}" Width="180" Background="#FF17A2B8" Foreground="White" BorderThickness="0" Padding="8" Margin="0,0,10,0"/>

            <Button Content="{Binding ToggleViewButtonText}" Command="{Binding ToggleViewCommand}" Width="408" Background="#FF6C757D" Foreground="White" BorderThickness="0" Padding="8" Height="33"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding TestCases}" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#FFF0F0F0" SelectionChanged="DataGrid_SelectionChanged">

            <DataGrid.Resources>
                <Style x:Key="ExpandableText" TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="TextWrapping" Value="NoWrap"/>
                    <Setter Property="Padding" Value="2"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>

                <DataGridTextColumn Header="Testcase ID" Binding="{Binding ExternalId}" Width="100"/>

                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <StaticResource ResourceKey="ExpandableText"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <StaticResource ResourceKey="ExpandableText"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Covered requirements" Binding="{Binding CoveredRequirementsText}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <StaticResource ResourceKey="ExpandableText"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="70"/>

                <DataGridTemplateColumn Header="Actions" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Deactivate" Command="{Binding DataContext.DeactivateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#FFDC3545" Foreground="White" BorderThickness="0" Padding="5,2">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="IsEnabled" Value="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>