<UserControl x:Class="TCM.DesktopClient.Views.ProjectDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding CurrentProject.Name}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Foreground="#333"/>

            <Menu Grid.Column="1" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Right">
                <MenuItem Header="☰" FontSize="22" Foreground="#333" Padding="10,5" Cursor="Hand" ToolTip="Menu">

                    <MenuItem Header="Back to projects list" Command="{Binding BackCommand}" FontSize="14" Padding="10,5" Margin="0,2"/>

                    <Separator Margin="0,5"/>

                    <MenuItem Header="Log out" Command="{Binding LogoutCommand}" FontSize="14" Foreground="#DC3545" FontWeight="SemiBold" Padding="10,5" Margin="0,2"/>

                </MenuItem>
            </Menu>
        </Grid>

        <Border Grid.Row="1" Background="#FFEAEAEA" CornerRadius="5" Padding="5" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="Dashboard" Command="{Binding ShowSummaryCommand}" Width="120" Background="#FF007ACC" Foreground="White" BorderThickness="0" Padding="8" Margin="0,0,10,0"/>
                <Button Content="Requirements" Command="{Binding ShowRequirementsCommand}" Width="120" Background="#FF007ACC" Foreground="White" BorderThickness="0" Padding="8" Margin="0,0,10,0"/>
                <Button Content="Test Cases" Command="{Binding ShowTestCasesCommand}" Width="120" Background="#FF007ACC" Foreground="White" BorderThickness="0" Padding="8" Margin="0,0,10,0"/>
                <Button Content="Test Runs" Command="{Binding ShowTestRunsCommand}" Width="120" Background="#FF007ACC" Foreground="White" BorderThickness="0" Padding="8" Margin="0,0,10,0"/>
                <Button Content="Team" Command="{Binding ShowTeamCommand}" Width="100" Background="#FF007ACC" Foreground="White" BorderThickness="0" Padding="8" Margin="0,0,10,0"/>
            </StackPanel>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding CurrentSubView}"/>
    </Grid>
</UserControl>