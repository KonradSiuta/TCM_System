<UserControl x:Class="TCM.DesktopClient.Views.RequirementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Import from CSV" Command="{Binding ImportCsvCommand}" IsEnabled="{Binding IsAdmin}" Width="130" Background="#FF28A745" Foreground="White" BorderThickness="0" Padding="8"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Requirements}" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#FFF0F0F0">

            <DataGrid.Resources>
                <Style x:Key="ExpandableText" TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="TextWrapping" Value="NoWrap"/>
                    <Setter Property="Padding" Value="2"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Testcase ID" Binding="{Binding ExternalRequirementId}" Width="100"/>

                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="200">
                    <DataGridTextColumn.ElementStyle>
                        <StaticResource ResourceKey="ExpandableText"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="60"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>

                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <StaticResource ResourceKey="ExpandableText"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Covered by testcases" Binding="{Binding CoveredByTests}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <StaticResource ResourceKey="ExpandableText"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>