<UserControl x:Class="TCM.DesktopClient.Views.TeamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFEAEAEA" Padding="15" Margin="0,0,0,15" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="Add or Update Team Member" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="User:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding AvailableSystemUsers}" 
                              SelectedItem="{Binding SelectedSystemUser}" 
                              DisplayMemberPath="Username" 
                              Width="150" Padding="5" Margin="0,0,20,0" 
                              ToolTip="Select a user to add or update"/>
                    <TextBlock Text="Role:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding SelectedRole}" Width="120" Padding="5" Margin="0,0,20,0"/>

                    <Button Content="Save Member" Command="{Binding SaveMemberCommand}" Width="120" Background="#FF28A745" Foreground="White" BorderThickness="0" Padding="5"/>
                </StackPanel>
                <TextBlock Text="Note: If the user is already in the project, clicking 'Save' will update their role." Foreground="Gray" FontStyle="Italic" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Members}" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#FFF0F0F0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="User ID" Binding="{Binding UserId}" Width="80"/>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150" FontWeight="SemiBold"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                <DataGridTextColumn Header="Assigned Role" Binding="{Binding Role}" Width="120" Foreground="#FF007ACC" FontWeight="Bold"/>

                <DataGridTemplateColumn Header="Actions" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Remove" Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#FFDC3545" Foreground="White" BorderThickness="0" Padding="5,2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>