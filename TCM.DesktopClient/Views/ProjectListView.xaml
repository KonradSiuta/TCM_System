<UserControl x:Class="TCM.DesktopClient.Views.ProjectListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">

        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCreatingProject}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Select project" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Foreground="#333"/>

                <Menu Grid.Column="1" Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <MenuItem Header="☰" FontSize="22" Foreground="#333" Padding="10,5" Cursor="Hand" ToolTip="User Menu">
                        <MenuItem Header="Log out" Command="{Binding LogoutCommand}" FontSize="14" Foreground="#DC3545" FontWeight="SemiBold" Padding="10,5"/>
                    </MenuItem>
                </Menu>
            </Grid>

            <DataGrid ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="250" Margin="0,0,0,20">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="250">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Code parser" Binding="{Binding ParserName}" Width="120" Foreground="Gray"/>
                    <DataGridTextColumn Header="Results format" Binding="{Binding TestResultParser}" Width="120" Foreground="Gray"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" Foreground="#FF17A2B8" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Created at" Binding="{Binding CreatedAt, StringFormat=\{0:yyyy-MM-dd\}}" Width="100"/>
                </DataGrid.Columns>
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenProjectCommand}"/>
                </DataGrid.InputBindings>
            </DataGrid>

            <Button Content="Create New Project" Command="{Binding ShowCreateFormCommand}" Width="200" HorizontalAlignment="Left" Background="#FF007ACC" Foreground="White" FontWeight="Bold" Padding="10"/>
        </StackPanel>


        <Border Background="#F9F9F9" Padding="20" CornerRadius="8" BorderBrush="#DDDDDD" BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCreatingProject}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel Width="500">
                <TextBlock Text="Configure New Project" FontSize="22" FontWeight="Bold" Margin="0,0,0,20" Foreground="#333"/>

                <TextBlock Text="Project Name:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NewProjectName}" Padding="8" Margin="0,0,0,15" FontSize="14"/>

                <TextBlock Text="Description:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox Text="{Binding NewProjectDescription}" Padding="8" Margin="0,0,0,15" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>

                <TextBlock Text="System Integrations" FontSize="16" FontWeight="Bold" Margin="0,15,0,10" Foreground="#007ACC"/>

                <TextBlock Text="Test Cases Code Parser (Regex Template):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableParsers}" SelectedItem="{Binding SelectedParserName}" Padding="5" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="Import .json" Command="{Binding UploadTestCaseParserCommand}" Background="#FF17A2B8" Foreground="White" BorderThickness="0" Padding="10,5"/>
                </Grid>

                <TextBlock Text="Automated Test Results Parser format:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableTestResultParsers}" SelectedItem="{Binding SelectedTestResultParser}" Padding="5" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="Import .json" Command="{Binding UploadTestResultParserCommand}" Background="#FF17A2B8" Foreground="White" BorderThickness="0" Padding="10,5"/>
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Save &amp; Create" Command="{Binding CreateProjectCommand}" Width="150" Background="#FF28A745" Foreground="White" FontWeight="Bold" Padding="10" Margin="0,0,15,0"/>
                    <Button Content="Cancel" Command="{Binding CancelCreateCommand}" Width="100" Background="#FF6C757D" Foreground="White" Padding="10"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>