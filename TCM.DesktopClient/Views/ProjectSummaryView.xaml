<UserControl x:Class="TCM.DesktopClient.Views.ProjectSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Project overview" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#333"/>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,25">

            <Border Background="White" CornerRadius="8" Padding="15" Margin="10" BorderBrush="#E0E0E0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Requirement coverage" FontSize="16" FontWeight="SemiBold" Foreground="#555" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="100" Height="100" Stroke="#DC3545" StrokeThickness="20" />
                        <Ellipse Width="100" Height="100" Stroke="#28A745" StrokeThickness="20"
                                 StrokeDashArray="{Binding CoverageDashArray}"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Summary.CoveragePercentage, StringFormat='{}{0:F0}%'}" FontSize="20" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Summary.CoveredRequirements, StringFormat='Covered tests: {0}'}" HorizontalAlignment="Center" Margin="0,15,0,0" Foreground="Gray" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Summary.TotalRequirements, StringFormat='Total requirements to cover: {0}'}" HorizontalAlignment="Center" Foreground="Gray"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="10" BorderBrush="#E0E0E0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Requirements by status" FontSize="16" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <ItemsControl ItemsSource="{Binding ReqStatusChart}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Foreground="#555" FontSize="11" TextTrimming="CharacterEllipsis"/>

                                    <Border Grid.Column="1" Background="#F0F0F0" CornerRadius="4" Height="14" HorizontalAlignment="Left" Width="180">
                                        <Border Background="{Binding ColorHex}" CornerRadius="4" HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                                    </Border>

                                    <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#333"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="10" BorderBrush="#E0E0E0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#DDDDDD" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Active tests by priority" FontSize="16" FontWeight="SemiBold" Foreground="#555" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <ItemsControl ItemsSource="{Binding TcPriorityChart}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Foreground="#555" FontSize="11" TextTrimming="CharacterEllipsis"/>

                                    <Border Grid.Column="1" Background="#F0F0F0" CornerRadius="4" Height="14" HorizontalAlignment="Left" Width="180">
                                        <Border Background="{Binding ColorHex}" CornerRadius="4" HorizontalAlignment="Left" Width="{Binding BarWidth}"/>
                                    </Border>

                                    <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#333"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Grid.Row="2" Margin="10,0,10,0">
            <TextBlock Text="Attention: outdated requirements" FontSize="18" FontWeight="Bold" Foreground="#DC3545" Margin="0,0,0,5"/>
            <TextBlock Text="These tests cover to an older version of a requirement, or the requirement has been canceled. Please update the test code and re-import." Foreground="Gray" Margin="0,0,0,15" FontSize="13"/>

            <DataGrid ItemsSource="{Binding Summary.OutdatedTestCases}" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#FFF9F9F9" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" HeadersVisibility="Column" RowHeight="30" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Testcase ID" Binding="{Binding TestCaseExternalId}" Width="120" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Testcase title" Binding="{Binding TestCaseTitle}" Width="*"/>
                    <DataGridTextColumn Header="Requirement ID" Binding="{Binding RequirementExternalId}" Width="150"/>
                    <DataGridTextColumn Header="Covered version" Binding="{Binding CoveredVersion, StringFormat='v{0}'}" Width="100"/>
                    <DataGridTemplateColumn Header="Current version / status" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontWeight="Bold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding CurrentRequirementVersion, StringFormat='v{0}'}"/>
                                            <Setter Property="Foreground" Value="#DC3545"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRequirementCanceled}" Value="True">
                                                    <Setter Property="Text" Value="CANCELED"/>
                                                    <Setter Property="Foreground" Value="#6F42C1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>