<UserControl x:Class="TCM.DesktopClient.Views.ProjectSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Project Dashboard" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,20">
            <Border Background="#FF17A2B8" CornerRadius="8" Padding="15" Margin="5">
                <StackPanel>
                    <TextBlock Text="Requirement Coverage" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Summary.CoveragePercentage, StringFormat='{}{0:F1}%'}" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Summary.CoveredRequirements, StringFormat='Covered: {0}'}" Foreground="White" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding Summary.TotalRequirements, StringFormat='Total: {0}'}" Foreground="White"/>
                </StackPanel>
            </Border>

            <Border Background="#FF28A745" CornerRadius="8" Padding="15" Margin="5">
                <StackPanel>
                    <TextBlock Text="Test Cases" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Summary.ActiveTestCases}" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Summary.TotalTestCases, StringFormat='Total Created: {0}'}" Foreground="White" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#FF6F42C1" CornerRadius="8" Padding="15" Margin="5">
                <StackPanel>
                    <TextBlock Text="Test Runs" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding Summary.TotalTestRuns}" Foreground="White" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Total Execution Cycles" Foreground="White" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Action Required: Outdated Test Coverage" FontSize="16" FontWeight="Bold" Foreground="#FFDC3545" Margin="0,0,0,10"/>
            <TextBlock Text="These tests point to an older version of a requirement. Please update the test code and re-import." Foreground="Gray" Margin="0,0,0,10" TextWrapping="Wrap"/>

            <DataGrid ItemsSource="{Binding Summary.OutdatedTestCases}" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#FFF0F0F0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Test ID" Binding="{Binding TestCaseExternalId}" Width="100" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Test Title" Binding="{Binding TestCaseTitle}" Width="250"/>
                    <DataGridTextColumn Header="Requirement ID" Binding="{Binding RequirementExternalId}" Width="150"/>
                    <DataGridTextColumn Header="Covered Version" Binding="{Binding CoveredVersion}" Width="100"/>
                    <DataGridTextColumn Header="Current Version" Binding="{Binding CurrentRequirementVersion}" Width="100" Foreground="Red" FontWeight="Bold"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Grid>
</UserControl>