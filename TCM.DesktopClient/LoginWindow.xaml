<Window x:Class="TCM.DesktopClient.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TCM System - Logowanie" Height="330" Width="350" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Zaloguj się do TCM" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Nazwa użytkownika:" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="UsernameTxt" Margin="0,0,0,10" Padding="5"/>

            <TextBlock Text="Hasło:" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,15" Padding="5"/>

            <TextBlock x:Name="ErrorText" Foreground="Red" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>

            <Button x:Name="LoginBtn" Content="Zaloguj" Padding="10" Background="#FF007ACC" Foreground="White" BorderThickness="0" Click="LoginButton_Click"/>
        </StackPanel>
    </Grid>
</Window>