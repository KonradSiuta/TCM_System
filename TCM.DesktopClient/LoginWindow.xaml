<Window x:Class="TCM.DesktopClient.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TCM System - Logowanie" Height="330" Width="350" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Log in to TCM System" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Username:" Margin="10,0,0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="UsernameTxt" Margin="10,0,10,10" Padding="5"/>

            <TextBlock Text="Password:" Margin="10,0,0,5" FontWeight="SemiBold"/>
            <PasswordBox x:Name="PasswordBox" Margin="10,0,10,15" Padding="5"/>

            <TextBlock x:Name="ErrorText" Foreground="Red" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>

            <Button x:Name="LoginBtn" Content="Log in" Padding="10" Margin="10,0,10,0" Background="#FF007ACC" Foreground="White" BorderThickness="0" Click="LoginButton_Click"/>

            <Button Content="Create new account" Margin="10,15,10,0" Background="Transparent" Foreground="#FF007ACC" BorderThickness="0" Click="OpenRegister_Click"/>
        </StackPanel>
    </Grid>
</Window>