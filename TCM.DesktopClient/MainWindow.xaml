<Window x:Class="TCM.DesktopClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:TCM.DesktopClient.ViewModels"
        xmlns:views="clr-namespace:TCM.DesktopClient.Views"
        Title="TCM System" Height="550" Width="900" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:ProjectListViewModel}">
            <views:ProjectListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ProjectDetailsViewModel}">
            <views:ProjectDetailsView/>
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding CurrentView}"/>
</Window>