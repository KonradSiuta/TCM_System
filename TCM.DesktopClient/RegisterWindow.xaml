<Window x:Class="TCM.DesktopClient.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TCM System - Create New User" Height="420" Width="350" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Załóż nowe konto" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Username:" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="UsernameTxt" Margin="0,0,0,10" Padding="5"/>

            <TextBlock Text="Email:" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="EmailTxt" Margin="0,0,0,10" Padding="5"/>

            <TextBlock Text="Passwword:" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10" Padding="5"/>

            <TextBlock Text="Confirm password:" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,15" Padding="5"/>

            <TextBlock x:Name="StatusText" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"/>

            <Button x:Name="RegisterBtn" Content="Create account" Padding="10" Background="#FF28A745" Foreground="White" BorderThickness="0" Click="RegisterButton_Click"/>

            <Button Content="Sing in" Background="Transparent" Foreground="#FF007ACC" BorderThickness="0" Margin="0,15,0,0" Click="BackToLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>